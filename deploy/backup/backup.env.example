# DavetKart yedek ayarlari (ORNEK; gercek deger YOK). Ayrinti: docs/rehber/deploy/backup/pg-dump.md
# Kurulum: sudo install -m 600 -o root -g root deploy/backup/backup.env.example /etc/davetkart/backup.env
#          sudo nano /etc/davetkart/backup.env      (degerleri SUNUCUDA doldur; depoya ve sohbete yazma)
# Bu dosyayi bash okur: icinde '&' ya da bosluk olan degeri TEK TIRNAK icine al.

# Yedek bucket'i (medya bucket'i DEGIL). Kucuk harf; bu yer tutucu bilerek gecersiz.
BACKUP_S3_BUCKET=davetkart-backup-DEGISTIR

# 'davetkart-backup' IAM kullanicisinin anahtari: yalnizca s3:PutObject (daily/*). Okuyamaz, silemez.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Istege bagli kalp atisi (ornek: Sentry Crons). Bos birakilirsa yalnizca gunluk yazilir.
# Basarida ilki, hatada ikincisi cagrilir; adres anahtar tasir, gunluge yazilmaz.
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=

# Varsayilanlar (degistirmen gerekmez)
# BACKUP_DB_NAME=davetkart
# BACKUP_PG_OS_USER=postgres
