APP_NAME=DavetKart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# K21: Backend TEK DIL konusur (en). API yanitlarinda metin donmez, hata kodu doner.
# Ceviri frontend'in isi. APP_FAKER_LOCALE ayri konu: sahte TEST verisi uretir.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# K32: parola hash'i Argon2id. bcrypt yalnizca CPU tuketir; Argon2id ayrica
# BELLEK tuketir ve saldirganin GPU/ASIC ile paralel deneme kapasitesini dusurur.
# Degerler Laravel varsayilanlarinin aynisidir, acikca yazildi: bu bir guvenlik
# parametresidir, gorunmez olmamali. Uretim donanimina gore ayar Faz 9'da.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Yalnizca bcrypt icin gecerli; surucu degistigi icin artik etkisiz.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 - gelistirme, test ve uretimde ayni motor (K19: dev/prod parity).
# 127.0.0.1, "localhost" degil: Windows'ta localhost once IPv6 (::1) denenir ve gecikir.
# Parolayi .env icine yaz; bu dosya repoda oldugu icin BOS kalir.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=davetkart
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bilgi@davetkart.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# DavetKart'a ozgu degiskenler (Faz 9'da eklendi)
# =============================================================================
#
# 🔴 Bu blok Faz 9'a kadar EKSIKTI ve bu sessiz bir hataydi: temiz bir klon
# alan biri (ya da yeni bir sunucu) bu degiskenlerin VAR OLDUGUNU bile
# bilemezdi. Kod calisiyordu, cunku her config satiri bir varsayilan tasiyor —
# ama varsayilanlar GELISTIRME icin secilmisti. Uretimde sessizce yanlis
# tarafa duserlerdi.
#
# B10'un ikinci uygulamasi: kurulumun bagimli oldugu her sey depoda durur.

# --- CORS (9.12) -------------------------------------------------------------
# Virgulle ayrilmis origin listesi. Sondaki '/' YAZILMAZ — origin'de yol yoktur.
# Gelistirme: Vite sunucusu. Uretim: frontend'in gercek alan adi.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Odeme (Faz 7) -----------------------------------------------------------
# 'fake' | 'iyzico'. 🔴 Bilinmeyen bir deger SESSIZ varsayilana DUSMEZ (K70):
# odeme uclari 503 verir, sistemin geri kalani calismaya devam eder.
PAYMENT_PROVIDER=fake
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_WEBHOOK_SECRET=

# Odeme sonrasi kullanicinin donecegi FRONTEND rotalari (backend degil).
PAYMENT_SUCCESS_URL=/odeme/basarili
PAYMENT_FAILURE_URL=/odeme/hata

# --- AI asistan (Faz 8) ------------------------------------------------------
# 'null' | 'gemini'. NullProvider aga HIC cikmaz; varsayilan odur ki bir
# yapilandirma eksigi PARA harcamasin.
AI_PROVIDER=null
GEMINI_API_KEY=

# --- Medya (Faz 6) -----------------------------------------------------------
# 🔴 'public' = storage/app/public + sembolik bag = WEB KOKU ALTINDA (K55).
# Uretimde S3 uyumlu bir diske gecilmeli; media.disk KOLONDA saklandigi icin
# (F4) eski satirlar gocten sonra da kendi diskinden cozulur.
DAVETKART_MEDIA_DISK=public

# Saat dilimi belirtmemis davetiyelerin varsayilani (K63/K71).
# Bir IS TERCIHIDIR (E6): pazar degisirse kod degismemeli.
DAVETKART_DEFAULT_TIMEZONE=Europe/Istanbul
