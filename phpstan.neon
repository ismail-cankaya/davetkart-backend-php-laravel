includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Taranacak klasorler. vendor/ ve storage/ bilincli olarak disarida.
    paths:
        - app
        - config
        - database
        - routes
        - tests

    # 0-10 arasi katilik. K22 takvimi: Faz 0-1 -> 5, Faz 2 -> 6, Faz 5 -> 8.
    # 6: eksik tip bildirimlerini yakalar (array'in ic tipi, generic parametreler).
    level: 6

    # Laravel'in "sihirli" ozelliklerini (Model::where, relation) anlamak icin
    # Larastan modelleri calistirmadan cozumler. Bellek siniri gerekir.
    treatPhpDocTypesAsCertain: false

    # Eloquent modellerinde tanimsiz ozellik erisimini yakala.
    checkModelProperties: true

    # 🔴 Laravel 11+ `casts()` METODU icin sart. Varsayilan false; o durumda
    # Larastan metodun BILDIRILEN donus tipine bakar, bizimki array<string,string>
    # oldugu icin sabit dizi degildir ve TUM cast'ler sessizce yok sayilir —
    # `event_at` CarbonImmutable degil string gorunur. true: metodun govdesi
    # AST'den okunur. Gerekce ve kanit: docs/rehber/phpstan.md §4.
    parseModelCastsMethod: true

    # Kod Laravel 13 + PHP 8.3 hedefliyor.
    phpVersion: 80300

    ignoreErrors:
        # Laravel'in Facade ve Model cephelerinde statik cozumleme sinirli kalir;
        # Larastan cogunu cozer, kalan istisnalar buraya EK GEREKCEYLE yazilir.
        # Su an bos: hicbir istisna kabul edilmedi.
