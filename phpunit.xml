<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <!-- 🔴 Faz 10 (10.79b): butun satirlar <server>, <env> DEGIL. Laravel
             env'i once $_SERVER'dan okur; kabukta ya da CI'da tanimli gercek
             bir degisken orada durur ve <env>'i (force="true" ile bile) ezer.
             DB_DATABASE icin bu, RefreshDatabase'in YANLIS veritabaninin
             tablolarini silmesi demekti. <server> $_SERVER'a yazar ve kazanir.
             Ayrintisi: docs/rehber/phpunit.md §4. -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!-- K19: testte de PostgreSQL. Ayri veritabani, cunku RefreshDatabase
             her kosuda tablolari siler ve yeniden kurar. -->
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="davetkart_test"/>
        <server name="DB_URL" value=""/>
        <!-- DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD .env'den gelir.
             Bu dosya repoda oldugu icin buraya PAROLA YAZILMAZ. -->

        <!-- Testler hizli ve yan etkisiz kosmali: her sey bellekte. -->
        <server name="CACHE_STORE" value="array"/>
        <!-- Faz 13: testler Faz 12 dunyasinda baslar (kart + kod acik). Bir
             yontemi kapatan test bunu Config::set ile kendisi yapar. -->
        <server name="PAYMENT_METHODS" value="card,gift_code"/>
        <server name="BANK_TRANSFER_BANK_NAME" value=""/>
        <server name="BANK_TRANSFER_ACCOUNT_HOLDER" value=""/>
        <server name="BANK_TRANSFER_IBAN" value=""/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="FILESYSTEM_DISK" value="local"/>

        <!-- Hash maliyeti testte dusuk: burada guvenlik degil hiz onemli.
             K32 ile surucu Argon2id oldugu icin ARGON_* degerleri belirleyici;
             BCRYPT_ROUNDS artik etkisiz ama surucu geri alinirsa diye duruyor.
             64 MB / 4 tur uretim degeridir; her testte odenirse suite dakikalara cikar. -->
        <server name="HASH_DRIVER" value="argon2id"/>
        <server name="ARGON_MEMORY" value="1024"/>
        <server name="ARGON_TIME" value="1"/>
        <server name="ARGON_THREADS" value="1"/>
        <server name="BCRYPT_ROUNDS" value="4"/>

        <!-- K21: backend tek dil konusur. -->
        <server name="APP_LOCALE" value="en"/>
        <server name="APP_FALLBACK_LOCALE" value="en"/>

        <!-- K20 sizinti testleri icin uretim kipi varsayilan. Debug blogunu
             test eden senaryolar config(['app.debug' => true]) ile acar. -->
        <server name="APP_DEBUG" value="false"/>

        <!-- 🔴 Faz 10 (10.17): testler Sentry'ye ASLA olay gondermez; bilerek
             firlatilan istisnalar da dahil. <server> burada ilk kez denendi
             (kilavuz §4.1); 10.79b onu butun satirlara yaydi.
             Bos deger SENTRY_DSN yedegine de dusmez: env() "" dondurur,
             null degil; config "" verince SDK kendi varsayilanini okumaz. -->
        <server name="SENTRY_LARAVEL_DSN" value=""/>

        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
